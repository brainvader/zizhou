{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-appdata-write",
    "fs:allow-appdata-write-recursive",
    "dialog:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "$APPDATA/**" }]
    },
    "fs:allow-watch"
  ]
}
